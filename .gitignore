# Stato di sessione di Obsidian: layout dei pannelli, file aperti, cursore.
# E' personale di chi apre il vault e cambierebbe a ogni sessione.
.obsidian/
vault/.obsidian/workspace*
__pycache__/
*.pyc
.venv/
node_modules/
.DS_Store
public/
# Clone effimero di Quartz usato per costruire il sito: scripts/costruisci_sito.sh
# lo rifà da solo quando manca o quando è al commit sbagliato.
.quartz-build/
.superpowers/
# Dataset esterni scaricati dall'ingest: rigenerabili, non vanno versionati.
.cache/

# Documenti di lavoro del progetto (spec, piano, ledger, prompt di ripresa):
# restano in locale e fuori dal repository pubblico. Copia in
# ../elements-caos-superpowers.
docs/superpowers/
