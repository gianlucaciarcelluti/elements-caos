<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
<title>La scoperta degli elementi</title>
<link>{{ base }}/</link>
<description>I 118 elementi chimici nell'ordine in cui l'umanità li ha scoperti.</description>
<language>it-IT</language>
{% for voce in voci %}
<item>
<title>{{ voce.elemento.nome }} ({{ voce.elemento.simbolo }}) — {{ voce.anno }}</title>
<link>{{ voce.url }}</link>
<guid isPermaLink="true">{{ voce.url }}</guid>
<description>{{ voce.descrizione }}</description>
</item>
{% endfor %}
</channel>
</rss>
