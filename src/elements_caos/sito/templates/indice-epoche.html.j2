{% extends "base.html.j2" %}
{% set radice = "../" %}

{% block titolo %}Le epoche{% endblock %}
{% block descrizione %}Le sei epoche in cui si raggruppa la scoperta degli elementi.{% endblock %}

{% block contenuto %}
<article class="contesto">
<header class="contesto__testa">
<p class="contesto__occhiello">Indice</p>
<h1>Le {{ voci | length }} epoche</h1>
<p>Il racconto è diviso in sei stagioni, ciascuna con il suo modo di trovare gli elementi.</p>
</header>

<ul class="porte__voci">
{% for voce in voci %}
<li class="porta epoca--{{ voce.epoca.id }}">
<h2><a href="{{ radice }}{{ voce.url }}">{{ voce.epoca.nome }}</a></h2>
<p class="epoca__estremi">{{ voce.inizio }} — {{ voce.fine }} · {{ voce.quanti }} elementi</p>
<p>{{ voce.epoca.descrizione }}</p>
</li>
{% endfor %}
</ul>
</article>
{% endblock %}
