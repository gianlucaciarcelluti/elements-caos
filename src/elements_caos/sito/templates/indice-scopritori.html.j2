{% extends "base.html.j2" %}
{% set radice = "../" %}

{% block titolo %}Gli scopritori{% endblock %}
{% block descrizione %}I {{ totale }} scienziati a cui si devono gli elementi della tavola periodica.{% endblock %}

{% block contenuto %}
<article class="contesto">
<header class="contesto__testa">
<p class="contesto__occhiello">Indice</p>
<h1>Gli scopritori</h1>
<p>
I {{ totale }} scienziati a cui il vault attribuisce almeno un elemento, in
ordine alfabetico.
</p>
</header>

<ul class="elenco-nomi">
{% for voce in voci %}
<li class="nome">
<a href="{{ radice }}{{ voce.url }}">{{ voce.scopritore.nome }}</a>
<span class="nome__quanti">{{ voce.quanti }}</span>
</li>
{% endfor %}
</ul>
</article>
{% endblock %}
