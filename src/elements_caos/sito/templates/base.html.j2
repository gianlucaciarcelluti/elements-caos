<!DOCTYPE html>
<html lang="it" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block titolo %}{% endblock %}</title>
<meta name="description" content="{% block descrizione %}{% endblock %}">
<link rel="icon" href="{{ radice }}statico/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="{{ radice }}statico/temi.css">
<link rel="stylesheet" href="{{ radice }}statico/base.css">
{# Caricato nella testa e non in fondo: applica il tema prima della prima
   pittura, altrimenti chi ha scelto lo scuro vede un lampo di chiaro. #}
<script src="{{ radice }}statico/tema.js"></script>
<script src="{{ radice }}statico/ricerca.js" defer></script>
{% block testa_extra %}{% endblock %}
</head>
<body>
<header class="testata">
<a class="testata__sito" href="{{ radice }}index.html">La scoperta degli elementi</a>
{# Nascosto finché il JS non lo mostra: senza JS non funzionerebbe, e un
   comando che non fa nulla è peggio di un comando assente. #}
<button type="button" id="scelta-tema" class="testata__tema" hidden aria-pressed="false">Scuro</button>
</header>

{# Il campo nasce nascosto: senza JavaScript non cercherebbe nulla. #}
<div class="ricerca" id="ricerca" hidden data-indice="{{ radice }}statico/indice.json" data-radice="{{ radice }}">
<label class="ricerca__etichetta" for="campo-ricerca">Cerca un elemento, uno scopritore, un anno</label>
<input type="search" id="campo-ricerca" autocomplete="off" placeholder="fosforo, P, 1669, Brand…">
<ul class="esiti" id="esiti-ricerca" hidden></ul>
</div>

<main id="contenuto">
{% block contenuto %}{% endblock %}
</main>

<footer class="chiusura">
<div class="avvertenza" role="note">
<p class="avvertenza__titolo">Avvertenza</p>
{{ avvertenza_ia }}
</div>
<nav class="chiusura__link">
<a href="{{ radice }}cronologia-degli-elementi.html">Cronologia</a>
<a href="{{ radice }}tavola-periodica.html">Tavola periodica</a>
<a href="{{ radice }}attribuzioni.html">Attribuzioni</a>
<a href="https://github.com/gianlucaciarcelluti/elements-caos">Repository</a>
</nav>
</footer>
</body>
</html>
